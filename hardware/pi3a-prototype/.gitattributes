# Preserve exact CAD/report bytes and SHA-256 evidence across Windows checkouts.
* -text whitespace=cr-at-eol
# KiCad 8 emits indented blank lines in generated boards.
*.kicad_pcb whitespace=cr-at-eol,-blank-at-eol
# Preserve generated STEP bytes and hashes; inspect through CAD, not textual diffs.
*.step binary
# Raw console progress retains tabs and carriage returns for diagnosis.
*.log whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
